# Copy to .env in the project root. Never commit .env.
# Local Python uses localhost; Compose overrides DB_HOST inside the backend container.
DB_HOST=localhost
DB_PORT=3306
DB_USER=kkbox_app
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_NAME=kkbox_dwh
# Adjust to the Python minor version used to train/export the ML artifacts.
PYTHON_VERSION=3.12
